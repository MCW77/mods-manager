{
	"name": "mods-manager",
	"version": "30.0.0",
	"type": "module",
	"scripts": {
		"check": "tsc && pn lint && pn test:run",
		"check:fix": "tsc && pn lint:fix && pn test:run",
		"preinstall": "npx only-allow pnpm",
		"dev": "vite --host=127.0.0.1",
		"dev:scan": "set \"VITE_ENABLE_REACT_SCAN=true\" && vite --host=127.0.0.1",
		"dev:nomock": "set \"VITE_NoMock=true\" && vite --host=127.0.0.1",
		"prebuild": "node scripts/write-version.js",
		"build": "tsc && vite build",
		"forcedbuild": "vite build",
		"lint": "biome lint ./src ./public",
		"lint:fix": "biome lint --write ./src ./public",
		"serve": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:migrations": "vitest run src/tests/migrations",
		"test:migrations:ui": "vitest --ui src/tests/migrations"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@fortawesome/fontawesome-svg-core": "^7.3.1",
		"@fortawesome/free-regular-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@fortawesome/react-fontawesome": "^3.5.0",
		"@legendapp/state": "3.0.0-beta.47",
		"@rolldown/plugin-babel": "^0.2.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"file-saver": "^2.0.5",
		"happy-dom": "^20.14.3",
		"i18next": "^26.4.2",
		"i18next-browser-languagedetector": "^8.2.1",
		"i18next-http-backend": "^4.0.2",
		"lodash-es": "^4.18.1",
		"lucide-react": "^1.44.0",
		"next-themes": "^0.4.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-i18next": "^17.0.13",
		"react-scan": "^0.5.7",
		"recharts": "^3.10.1",
		"sonner": "^2.0.8",
		"superjson": "^2.2.6",
		"tailwind-merge": "^3.6.0",
		"ts-pattern": "^5.9.0",
		"unocss-preset-animations": "^1.3.0",
		"valibot": "1.5.0",
		"vite-plugin-dynamic-import": "^1.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@iconify-json/logos": "^1.2.14",
		"@iconify-json/skill-icons": "^1.2.4",
		"@types/file-saver": "^2.0.7",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^26.5.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@unocss/preset-typography": "66.10.1",
		"@unocss/preset-wind4": "^66.10.1",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/ui": "^5.0.0",
		"fake-indexeddb": "^6.2.5",
		"typescript": "7.0.2",
		"unocss": "66.10.1",
		"unocss-preset-shadcn": "^1.0.1",
		"vite": "^8.3.0",
		"vite-bundle-analyzer": "^1.3.9",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^5.0.0",
		"workbox-window": "^7.4.1"
	},
	"config": {},
	"packageManager": "pnpm@11.25.0"
}
