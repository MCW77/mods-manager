{
  "name": "mods-manager",
  "version": "31.4.1",
  "type": "module",
  "scripts": {
    "check": "tsc --noemit && vp lint && vp test",
    "check:fix": "tsc --noemit && vp lint:fix && vp test",
    "preinstall": "npx only-allow pnpm",
    "dev": "vp dev --host=127.0.0.1",
    "dev:scan": "set \"VITE_ENABLE_REACT_SCAN=true\" && vp dev --host=127.0.0.1",
    "dev:nomock": "set \"VITE_NoMock=true\" && vp dev --host=127.0.0.1",
    "prebuild": "node scripts/write-version.js",
    "build": "tsc && vp build",
    "build:show-analyzer": "set \"VITE_SHOW_ANALYZER=true\" && tsc && vp build",
    "forcedbuild": "vp build",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "serve": "vp preview",
    "test": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test --coverage",
    "test:migrations": "vp test src/tests/migrations",
    "test:migrations:ui": "vp test --ui src/tests/migrations",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@legendapp/list": "^3.9.0",
    "@legendapp/state": "3.0.0-beta.47",
    "@rolldown/plugin-babel": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "file-saver": "^2.0.5",
    "happy-dom": "^21.0.4",
    "i18next": "^27.2.7",
    "i18next-browser-languagedetector": "^8.3.1",
    "i18next-http-backend": "^4.1.1",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.79.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-scan": "^0.5.7",
    "recharts": "^3.11.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.7",
    "ts-pattern": "^5.9.2",
    "unocss-preset-animations": "^1.3.0",
    "valibot": "1.5.0",
    "vite-plugin-dynamic-import": "^1.6.0"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.21",
    "@iconify-json/skill-icons": "^1.2.4",
    "@types/file-saver": "^2.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unocss/preset-typography": "66.13.0",
    "@unocss/preset-wind4": "^66.13.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "fake-indexeddb": "^6.2.8",
    "typescript": "7.0.2",
    "unocss": "66.13.0",
    "unocss-preset-scrollbar": "^4.0.0",
    "unocss-preset-shadcn": "^1.0.1",
    "vite": "catalog:",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "workbox-window": "^7.4.1"
  },
  "config": {},
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not Safari < 18.4"
  ],
  "packageManager": "pnpm@12.21.0"
}
